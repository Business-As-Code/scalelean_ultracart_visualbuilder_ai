# Copy to .env locally. Do not commit the copy.
# Fill credentials locally. Do not paste them into chat, Linear, or BAC.
UVB_ACCOUNT=
UVB_STOREFRONT_URL=

# Use explicit FTPS (FTPES) after the server, permitted root, and public-key
# pin are verified. Do not use SSH SFTP or plaintext FTP for this lab.
UVB_FILE_PROTOCOL=
UVB_FILE_HOST=
UVB_FILE_PORT=
UVB_FILE_USERNAME=
UVB_FILE_PASSWORD=
UVB_FILE_ROOT=
UVB_FILE_PINNED_PUBKEY=

# Local path to a private staging directory. This path must not be inside Git.
UVB_PRIVATE_ARTIFACT_ROOT=
